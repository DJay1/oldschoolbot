# You need to change these:
CLIENT_ID=PUT_YOUR_CLIENT_ID_HERE
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# You may need to change these:
ROBOCHIMP_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/robochimp_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/osb_test

# Optional
# Discord guild where guild commands are installed in dev, and where /admin is registered.
# The code reads TESTING_SERVER (not TESTING_SERVER_ID).
#TESTING_SERVER=123456789012345678
#TESTING_LOG_CHANNEL=123456789012345678
#GENERAL_CHANNEL=123456789012345678
#USE_REAL_PG=0

# Live play. PRODUCTION is read only by src/lib/hosting/productionMode.ts.
# true, 1, yes, or on turns off instant trips, test commands, and tester item grants.
# When PRODUCTION is unset, NODE_ENV=production still means production.
#PRODUCTION=true
# Comma-separated Discord user ids. Only these users can use /admin and /rp on a live bot.
#ADMIN_USER_IDS=123456789012345678

# Public Patreon page. Defaults to https://patreon.com/bscbot when unset.
#PATREON_URL=https://patreon.com/bscbot

# BSC patron tiers. Create Pup ($3), Good Boy ($7), and Top Dog ($15) on Patreon,
# turn on Patreon's Discord integration, and paste the role ids it assigns.
# SUPPORT_SERVER_ID is the guild those roles live in. Unset uses TESTING_SERVER.
#SUPPORT_SERVER_ID=
#PATRON_ROLE_PUP=
#PATRON_ROLE_GOODBOY=
#PATRON_ROLE_TOPDOG=
# Optional Patreon API v2 sync. Leave unset to use Discord roles only.
#PATREON_CREATOR_TOKEN=
#PATREON_CAMPAIGN_ID=
#PATREON_TIER_PUP_ID=
#PATREON_TIER_GOODBOY_ID=
#PATREON_TIER_TOPDOG_ID=

# Quality-check bounty board. Unset values use the Los Perros test-server defaults in
# src/lib/qualityChecks/config.ts. The board channel is the Forum #qc-bounties.
# The old #quality-checks channel is an archive. Do not use it as the board channel.
# Tag names are exact: open, claimed, needs-DJ, passed, failed.
# Ticker minutes: 0 or unset = command only.
#QUALITY_CHECK_GUILD_ID=1564440506866606101
#QUALITY_CHECK_CHANNEL_ID=1564459680997056604
#QUALITY_CHECK_UPDATES_CHANNEL_ID=1564454812349632562
#QUALITY_CHECK_ROLE_ID=1564455672270290975
#QUALITY_CHECK_TICKER_MINUTES=0
# Optional Discord user to ping on Done, in addition to the Quality Checkers role.
#QUALITY_CHECK_DJ_USER_ID=
# Optional known forum thread snowflakes: item-id:thread-id,item-id:thread-id
#QUALITY_CHECK_THREADS=

# Dont change these:
TZ="UTC"
