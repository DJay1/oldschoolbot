# Copy to .env.test and fill in. .env.test is gitignored.
# This is the TEST bot: a second Discord application, a second database, PRODUCTION=false.
# Do not set TEST=true here. That flag is only for the automated suite (.env.integration).

NODE_ENV=development
PRODUCTION=false
BSC_ENV=test
USE_REAL_PG=1

CLIENT_ID=PUT_YOUR_TEST_CLIENT_ID_HERE
BOT_TOKEN=PUT_YOUR_TEST_BOT_TOKEN_HERE

# Guild where the test bot registers every command (guild commands update immediately).
SUPPORT_GUILD_ID=PUT_YOUR_TEST_GUILD_ID_HERE
LOG_CHANNEL_ID=PUT_YOUR_TEST_LOG_CHANNEL_ID_HERE

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bsc_test?schema=public
ROBOCHIMP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robochimp_test?schema=public

# Same Redis server as prod, different database number and key prefix.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_KEY_PREFIX=bsc:test:

ICON_CACHE_DIR=icon_cache/test
LOG_DIR=logs/test

# Emoji snowflakes are per Discord application. This file is gitignored. Create it with pnpm emojis:sync.
APPLICATION_EMOJI_IDS_FILE=assets/emojis/application-emoji-ids.test.json

PG_POOL_MAX=10
PG_POOL_MIN=2

# Comma-separated Discord user ids. Only these users can use /admin and /rp when PRODUCTION=true.
# The test bot leaves PRODUCTION=false, so mods can still use /admin here.
#ADMIN_USER_IDS=

# Public Patreon page. Defaults to https://patreon.com/bscbot when unset.
PATREON_URL=https://patreon.com/bscbot

# Discord role ids for Pup, Good Boy, and Top Dog. Unset SUPPORT_SERVER_ID uses SUPPORT_GUILD_ID.
#PATRON_ROLE_PUP=
#PATRON_ROLE_GOODBOY=
#PATRON_ROLE_TOPDOG=
#SUPPORT_SERVER_ID=
# Optional Patreon API v2 sync. Leave unset to use Discord roles only.
#PATREON_CREATOR_TOKEN=
#PATREON_CAMPAIGN_ID=
#PATREON_TIER_PUP_ID=
#PATREON_TIER_GOODBOY_ID=
#PATREON_TIER_TOPDOG_ID=

TZ=UTC
