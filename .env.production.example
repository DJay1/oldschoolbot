# Copy to .env.production and fill in. .env.production is gitignored.
# Self-host guide: docs/RELEASE.md
# Two Discord applications. This file is the LIVE bot. Do not reuse the test bot token.

NODE_ENV=production
PRODUCTION=true
BSC_ENV=prod
USE_REAL_PG=1

CLIENT_ID=PUT_YOUR_PROD_CLIENT_ID_HERE
BOT_TOKEN=PUT_YOUR_PROD_BOT_TOKEN_HERE

# Guild where /admin and /rp are registered. Player commands are global.
SUPPORT_GUILD_ID=PUT_YOUR_PROD_GUILD_ID_HERE
# One channel that receives startup, economy, and error notices. Create it in the support guild.
LOG_CHANNEL_ID=PUT_YOUR_PROD_LOG_CHANNEL_ID_HERE

# Create these databases yourself. Prisma reads DATABASE_URL from this file via the prod scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bsc_prod?schema=public
ROBOCHIMP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robochimp_prod?schema=public

# One Redis (or Memurai) server. Prod uses database 0 and a key prefix so it does not share cache with the test bot.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=bsc:prod:

# Separate folders so the two processes do not write the same cache or log files.
ICON_CACHE_DIR=icon_cache/prod
LOG_DIR=logs/prod

# Emoji snowflakes are per Discord application. This file is gitignored. Create it with pnpm emojis:sync.
APPLICATION_EMOJI_IDS_FILE=assets/emojis/application-emoji-ids.prod.json

# Two bots on one Postgres. Keep the pools small so 4 pools fit under max_connections.
PG_POOL_MAX=10
PG_POOL_MIN=2

# Comma-separated Discord user ids. Only these users can use /admin and /rp. The application owner is added on login.
#ADMIN_USER_IDS=

# Public Patreon page. Defaults to https://patreon.com/bscbot when unset.
PATREON_URL=https://patreon.com/bscbot

# Discord role ids for Pup, Good Boy, and Top Dog. Unset SUPPORT_SERVER_ID uses SUPPORT_GUILD_ID.
#PATRON_ROLE_PUP=
#PATRON_ROLE_GOODBOY=
#PATRON_ROLE_TOPDOG=
#SUPPORT_SERVER_ID=
# Optional Patreon API v2 sync. Leave unset to use Discord roles only.
#PATREON_CREATOR_TOKEN=
#PATREON_CAMPAIGN_ID=
#PATREON_TIER_PUP_ID=
#PATREON_TIER_GOODBOY_ID=
#PATREON_TIER_TOPDOG_ID=

TZ=UTC
